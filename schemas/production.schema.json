{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Instagram production input",
  "type": "object",
  "required": [
    "content_id",
    "surface",
    "title",
    "caption",
    "cta",
    "hypothesis",
    "primary_metric",
    "counter_metric",
    "authoring_provenance",
    "frames"
  ],
  "properties": {
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "cta": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "counter_metric": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "reel",
        "story",
        "carousel"
      ]
    },
    "authoring_provenance": {
      "enum": [
        "human",
        "model_draft",
        "human_edited_model"
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "role",
          "headline",
          "text",
          "visual",
          "sound",
          "claim_basis"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "sound": {
            "type": "string",
            "minLength": 1
          },
          "continuation": {
            "type": "string",
            "minLength": 1
          },
          "spoken": {
            "type": "string",
            "minLength": 1
          },
          "claim_basis": {
            "enum": [
              "opinion",
              "instruction",
              "personal_experience",
              "external_evidence"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "surface": {
            "const": "reel"
          }
        }
      },
      "then": {
        "properties": {
          "frames": {
            "items": {
              "required": [
                "spoken",
                "start",
                "end"
              ]
            }
          }
        }
      }
    }
  ]
}
