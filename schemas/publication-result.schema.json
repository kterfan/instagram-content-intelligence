{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed publication snapshot",
  "type": "object",
  "required": [
    "account",
    "content_id",
    "revision",
    "media_id",
    "surface",
    "objective",
    "variant",
    "experiment_id",
    "traffic",
    "source_kind",
    "source_ref",
    "published_at",
    "observed_at",
    "window_hours",
    "reviewed"
  ],
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1
    },
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "media_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "reel",
        "story",
        "carousel"
      ]
    },
    "traffic": {
      "enum": [
        "organic",
        "paid",
        "mixed"
      ]
    },
    "source_kind": {
      "enum": [
        "meta_api",
        "instagram_dashboard",
        "manual_import"
      ]
    },
    "reviewed": {
      "const": true
    },
    "uncertain_fields": {
      "type": "array",
      "maxItems": 0
    },
    "window_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reach": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "shares": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "saved": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "likes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "comments": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "replies": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "views": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
